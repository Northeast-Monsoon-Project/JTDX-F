set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(FM_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(FM_TOOL_ROOT "${FM_ROOT}/.deps/root/usr")
set(FM_WIN_ROOT "${FM_ROOT}/.deps/msys2/ucrt64")
set(CMAKE_C_COMPILER "${FM_TOOL_ROOT}/bin/x86_64-w64-mingw32-gcc")
set(CMAKE_CXX_COMPILER "${FM_TOOL_ROOT}/bin/x86_64-w64-mingw32-g++")
set(CMAKE_Fortran_COMPILER "${FM_TOOL_ROOT}/bin/x86_64-w64-mingw32-gfortran")
set(CMAKE_RC_COMPILER "${FM_TOOL_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${FM_WIN_ROOT}" "${FM_TOOL_ROOT}/x86_64-w64-mingw32")
set(CMAKE_PREFIX_PATH "${FM_WIN_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(JTDX_HOST_QT_BIN "${FM_TOOL_ROOT}/bin" CACHE PATH "")
set(JTDX_OMNIRIG_GENERATED_DIR "${FM_ROOT}/jtdx-master/windows/omnirig" CACHE PATH "")

set(PKG_CONFIG_EXECUTABLE "${FM_ROOT}/scripts/pkg-config-windows" CACHE FILEPATH "" FORCE)

set(JTDX_TARGET_QT_PLUGINS "${FM_WIN_ROOT}/share/qt5/plugins" CACHE PATH "" FORCE)
set(RIGCTL_EXE "${FM_WIN_ROOT}/bin/rigctl.exe" CACHE FILEPATH "" FORCE)
set(RIGCTLD_EXE "${FM_WIN_ROOT}/bin/rigctld.exe" CACHE FILEPATH "" FORCE)
set(RIGCTLCOM_EXE "${FM_WIN_ROOT}/bin/rigctlcom.exe" CACHE FILEPATH "" FORCE)
